<Project Sdk="Microsoft.NET.Sdk">
  <!-- MessageLinkServer.exe (SWITCHBOARD.md stage 3): the process that hosts the backends when the window is not the one doing it. It draws
       nothing, so it is a WinExe, and it carries no WinUI and no Windows App SDK (a harness check fails if this project ever names them);
       what only Windows can do arrives through MessageLink.Windows. Everything a person can see of it says "Messages Server": the program,
       its window class, its mutex, its log. -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.22621.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <AssemblyName>MessageLinkServer</AssemblyName>
    <RootNamespace>MessageLink.Server.Windows</RootNamespace>
    <Product>Message Link Server</Product>
    <AssemblyTitle>Message Link Server</AssemblyTitle>
    <Description>Message Link Server</Description>
    <Company>wrenchware</Company>
    <!-- Compiled ahead of time on publish, for two reasons. The app's MessageLink.*.dll are, and the installer's build refuses two publishes
         that make a file of the same name with different contents. And the start then runs code instead of compiling it first (SWITCHBOARD.md
         3.1d): server started to server listening, warm 141 to 118 ms and first start on new files 413-422 to 239-250 ms, then 59 and 181 with
         ServerWarmUp, for 8 MB more on disk. Development builds are unchanged. -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <!-- Selects the WinRT form of the browser the Google renewal loads (MessageLink.Windows): the same projection and native
         Microsoft.Web.WebView2.Core.dll the app publishes. The App SDK sets this for the app by itself; the server has none (3.1c spike). -->
    <WebView2EnableCsWinRTProjection>true</WebView2EnableCsWinRTProjection>
    <!-- The app refuses a server whose version is not its own, so this is read from the app's project at build time: tools\Release.ps1 edits
         only that one line, and a copy here would fall behind it (a harness check compares the two). -->
    <Version>$([System.Text.RegularExpressions.Regex]::Replace($([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)../MessageLink.App/MessageLink.App.csproj')), '(?s)^.*?&lt;Version&gt;([^&lt;]+)&lt;/Version&gt;.*$', '$1'))</Version>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.15" />
    <ProjectReference Include="../MessageLink.Core/MessageLink.Core.csproj" />
    <ProjectReference Include="../MessageLink.Protocol/MessageLink.Protocol.csproj" />
    <ProjectReference Include="../MessageLink.Backends/MessageLink.Backends.csproj" />
    <ProjectReference Include="../MessageLink.Presentation/MessageLink.Presentation.csproj" />
    <ProjectReference Include="../MessageLink.Storage/MessageLink.Storage.csproj" />
    <ProjectReference Include="../MessageLink.Server/MessageLink.Server.csproj" />
    <!-- The network door, its page, pushes and pairing (SWITCHBOARD.md 10.7): the Linux host's, on 127.0.0.1 and the tailnet. It brings ASP.NET Core into this
         program only; the app never references it (ProtocolNetworkChecks). -->
    <ProjectReference Include="../MessageLink.Server.Network/MessageLink.Server.Network.csproj" />
    <ProjectReference Include="../MessageLink.Windows/MessageLink.Windows.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- No WinUI types, so the harness links this file as well. -->
    <Compile Include="../MessageLink.App/Services/RunMarker.cs" Link="RunMarker.cs" />
    <!-- The tailnet door's supervisor, the Linux host's own (plain C#, its namespace kept): the same arguments, line routing and restarts on Windows. -->
    <Compile Include="../MessageLink.Server.Linux/TailnetDoor.cs" Link="TailnetDoor.cs" />
    <!-- The same Message Link icon as the app's, shown while no window is open (owner, 2026-11-22): the app's tray code, which is plain Win32, and how the two
         find each other. The picture goes beside the program as it does beside the app; in the package both are one byte-identical file. -->
    <Compile Include="../MessageLink.App/Services/TrayIcon.cs" Link="TrayIcon.cs" />
    <Compile Include="../MessageLink.App/Services/TrayPresence.cs" Link="TrayPresence.cs" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="../MessageLink.App/Assets/AppIcon.ico" Link="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- The providers' helpers are found beside the program, as they are beside the app's (HelperConnection). -->
  <ItemGroup>
    <Content Include="../../helpers/GoogleMessages/helper/bin/gmessages-helper.exe" Link="gmessages-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../helpers/GoogleMessages/helper/bin/gmessages-helper.exe')" />
    <Content Include="../../helpers/Messenger/helper/bin/messenger-helper.exe" Link="messenger-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../helpers/Messenger/helper/bin/messenger-helper.exe')" />
    <Content Include="../../helpers/GoogleVoice/helper/bin/gvoice-helper.exe" Link="gvoice-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../helpers/GoogleVoice/helper/bin/gvoice-helper.exe')" />
    <Content Include="../../helpers/Instagram/helper/bin/instagram-helper.exe" Link="instagram-helper.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../helpers/Instagram/helper/bin/instagram-helper.exe')" />
    <!-- The server's own door on the owner's tailnet (SWITCHBOARD.md 10.7), built by helpers\Tailnet\Build.ps1; its modules' licences are in THIRD_PARTY_NOTICES.md. -->
    <Content Include="../../helpers/Tailnet/door/bin/windows-amd64/messages-tailnet.exe" Link="messages-tailnet.exe" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../../helpers/Tailnet/door/bin/windows-amd64/messages-tailnet.exe')" />
  </ItemGroup>
</Project>
